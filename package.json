{
  "name": "subechhya-bag-pasal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Subechhya Bag पसल — brand website, product catalogue and lead-generation site.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-content && node scripts/generate-sitemap.js && node scripts/generate-404.js && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "validate-content": "node scripts/validate-content.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "generate-404": "node scripts/generate-404.js"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.7",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
